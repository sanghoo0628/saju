{
  "name": "sai-campus",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.22.1 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "pnpm test:b && pnpm test:payments && pnpm test:a && pnpm test:ui",
    "test:a": "node --conditions=react-server --import tsx --test tests/a/*.test.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm demo:build",
    "test:http": "node --import tsx scripts/smoke-http.ts",
    "test:b": "vitest run",
    "test:payments": "node --test packages/payment-chat/test/*.test.ts",
    "test:all": "pnpm test",
    "test:ui": "vitest run --config packages/payment-chat-ui/vitest.config.ts",
    "test:postgres": "vitest run --config vitest.postgres.config.ts",
    "demo:dev": "pnpm --filter @saju/payment-chat-ui dev",
    "demo:build": "pnpm --filter @saju/payment-chat-ui build"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "@electric-sql/pglite": "0.5.16",
    "@electric-sql/pglite-socket": "0.2.19",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "vitest": "5.1.0"
  },
  "type": "module"
}
