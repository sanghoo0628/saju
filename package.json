    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "pg": "8.23.1"
  }
}
