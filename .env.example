# 실제 비밀값 없음. .env.local로 복사하고 필요한 값만 로컬에서 설정하세요.
# development는 로컬/내부 검증 전용. 공개 운영은 production을 명시해야 합니다.
# development: localhost only; preview: HTTPS test site; production: real providers only
APP_ENV=development

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 서버 전용. NEXT_PUBLIC_ 접두사 금지.
SUPABASE_SECRET_KEY=

# C PostgreSQL adapter용 서버 전용 접속 문자열. Supabase HTTP URL/API 키와 다릅니다.
# C 결제·채팅 API 요청 시 연결합니다. 빌드 중에는 접속하지 않습니다.
# 같은 개발 프로젝트의 DB 주소/TLS 및 SET LOCAL ROLE service_role 권한을 확인하세요.
DATABASE_URL=

# 팀이 확인한 학교 도메인만 쉼표로 입력. 운영에서 빈 목록을 전체 허용으로 처리하지 않음.
ALLOWED_EMAIL_DOMAINS=

# mock | unconfigured | hrum. hrum은 실제 유료 partner API를 호출합니다.
SAJU_PROVIDER=mock
# 32자 이상 무작위 서버 비밀값. hrum 키 설정 시 필수. 개발 mock만 임시 키 허용.
SAJU_FINGERPRINT_SECRET=
# 서버 전용 HRUM partner 키. NEXT_PUBLIC_ 금지; 채팅이나 git에 넣지 마세요.
# 미설정 hrum은 not_ready이며 guest/mock으로 대체하지 않습니다.
SAJU_API_KEY=
# 비워도 고정 HRUM endpoint 사용. 아래 base만 허용하며 임의 URL로 키를 보내지 않습니다.
# https://api.hrum.ai/api/v1/partners/v1
SAJU_API_BASE_URL=

# B 매칭 설정. legacy_demo_v1이 아니면 추천·생년월일 저장이 "준비 중"(503)으로 응답합니다.
MATCHING_STRATEGY=legacy_demo_v1
# B 고정 점수(생년월일 HMAC + 문이과 부호)용 서버 비밀값. 32자 이상, 팀 공용 값을 받아 넣으세요.
# HRUM 강약 원점수·SAJU_FINGERPRINT_SECRET과 별개입니다. 바꾸면 새로 만드는 점수만 달라집니다.
SCORE_HMAC_SECRET=

# 실제 Groble gateway 미구현: true 설정은 아직 거부. 프로필 무료 열람 → 선택 상대당 500원 대화 권한.
PAYMENTS_ENABLED=false
GROBLE_PAYMENT_URL=
GROBLE_PRODUCT_ID=
GROBLE_WEBHOOK_SECRET=
GROBLE_WEBHOOK_PREVIOUS_SECRET=
# Reserved: ISO-8601 expiry for a rotating previous key (maximum 24 hours).
GROBLE_WEBHOOK_PREVIOUS_SECRET_EXPIRES_AT=

# A는 결제 성공 mock 미제공. 개발 환경에서도 true 설정 거부.
MOCK_PAYMENTS_ENABLED=false

# P1/P2 예약 변수. A에서는 disabled만 허용, 실제 예약 없음.
ACTIVITY_BOOKING_PROVIDER=disabled
BOOKING_API_BASE_URL=
BOOKING_API_KEY=
BOOKING_WEBHOOK_SECRET=


# ===== 기존 main 템플릿 변수 (사용 여부 팀 확인 필요) =====
# LLM API (사주·타로 해석 생성)
LLM_API_KEY=
# (사용 시) 한국천문연구원 음양력 정보 API - 공공데이터포털
KASI_API_KEY=

# C DB TLS: Supabase Database Settings에서 받은 CA 인증서 파일 절대 경로
# Required for Supabase direct/pooler connections. Keep TLS verification enabled.
DATABASE_SSL_CA_PATH=
# Cloud deployment alternative: paste the Supabase CA PEM; never a private key.
# Inline PEM takes priority over a machine-specific local path.
DATABASE_SSL_CA_PEM=
