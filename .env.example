# 이 파일을 복사해서 .env 를 만들고 값을 채우세요:  cp .env.example .env
# ⚠️ .env 는 절대 커밋하지 마세요. 실제 값은 팀 채팅으로 공유합니다.
# ⚠️ NEXT_PUBLIC_ 이 붙은 값만 브라우저에 노출됩니다. 그 외는 서버 전용입니다.

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용 관리자 키 (브라우저 번들에 절대 포함 금지)
SUPABASE_SERVICE_ROLE_KEY=

# ===== 고정 점수 (B) =====
# 생년월일 → 기본 숫자(1~10,000) HMAC 비밀 키. 서버 전용. 변경해도 저장된 점수가 우선 사용됨.
SCORE_HMAC_SECRET=

# ===== 학교 이메일 인증 (A) =====
# 허용 도메인, 쉼표로 구분 (팀 확인 필요)
ALLOWED_EMAIL_DOMAINS=korea.ac.kr

# ===== 사주 프로그램 (A) =====
SAJU_API_URL=
SAJU_API_KEY=
# true 이면 가짜 사주 응답 사용 (개발용)
SAJU_USE_MOCK=true

# ===== Groble 결제 (C) =====
# 500원 상품 결제 링크 (서버가 ?ref=참조값 을 붙여 이동)
GROBLE_PAYMENT_URL=
GROBLE_WEBHOOK_SECRET=

# ===== 앱 설정 =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000
APP_ENV=development

# ===== C Repository: PostgreSQL 연결, 서버 전용 =====
# Supabase DB 직접/풀러 접속 문자열 (HTTP URL/API 키 아님). service_role로 SET ROLE 가능해야 함.
# docs/C_POSTGRES_ADAPTER_2026-11-17.txt 참고. 실제 값은 Git에 넣지 않는다.
DATABASE_URL=
